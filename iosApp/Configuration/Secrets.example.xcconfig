// Copy this file to Secrets.xcconfig and fill in the values.
// Do not commit Secrets.xcconfig. The .gitignore file leaves it out.

// Native app key of the Kakao Developers app.
KAKAO_NATIVE_APP_KEY=

// iOS client ID of Google Cloud, for example 1234-abcd.apps.googleusercontent.com.
GOOGLE_IOS_CLIENT_ID=

// iOS URL scheme of the same client, for example com.googleusercontent.apps.1234-abcd.
GOOGLE_REVERSED_CLIENT_ID=

// Web client ID of Google Cloud. The ID token then has the same audience as on Android.
GOOGLE_WEB_CLIENT_ID=
